VITE_SUPABASE_URL=your-project-url
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Optional: the site's own public address, e.g. https://thesnackhut.vercel.app
# Used for the WhatsApp/Facebook link-preview image and for sitemap.xml, both of
# which need absolute URLs.
#
# On Vercel you only need this for a CUSTOM domain — otherwise the build falls
# back to VERCEL_PROJECT_PRODUCTION_URL, which Vercel sets for you.
# ---------------------------------------------------------------------------
# VITE_SITE_URL=https://thesnackhut.vercel.app

# ---------------------------------------------------------------------------
# Optional: one-click WhatsApp broadcast (Admin → WhatsApp Blast).
# Server-side only — NO "VITE_" prefix, so these never reach the browser.
# Set them in Vercel → Settings → Environment Variables, then redeploy.
# Without them the admin panel falls back to the manual one-tap-per-customer
# flow, which needs no setup.
# ---------------------------------------------------------------------------
# WHATSAPP_TOKEN=permanent-access-token-of-your-whatsapp-system-user
# WHATSAPP_PHONE_ID=your-whatsapp-phone-number-id
# WHATSAPP_TEMPLATE=snack_hut_offer
# WHATSAPP_LANGUAGE=en_US

# ---------------------------------------------------------------------------
# Optional: email every new order to the shop (api/order-email.js).
# Server-side only — NO "VITE_" prefix. Without RESEND_API_KEY the endpoint
# quietly does nothing and checkout is completely unaffected.
#
# Sign up at resend.com with the SAME address you want the orders sent to, and
# the default sender below works immediately — no domain, no DNS setup.
# ---------------------------------------------------------------------------
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # required; keep it secret
# ORDER_EMAIL_TO=thesnackhut001@gmail.com           # comma-separate for several
# ORDER_EMAIL_FROM=The Snack Hut <onboarding@resend.dev>
# ORDER_EMAIL_SECRET=any-long-random-string         # only for supabase/order-email.sql
